# ===== Backend / MySQL =====
# 后端默认会使用 root/root 连接本机 MySQL，按需修改。
VOICE_TA_DATABASE_URL=mysql+pymysql://root:root@127.0.0.1:3306/voiceTA?charset=utf8mb4
VOICE_TA_DB_HOST=127.0.0.1
VOICE_TA_DB_PORT=3306
VOICE_TA_DB_USER=root
VOICE_TA_DB_PASSWORD=root

# ===== DashScope（也可在系统配置页面填写）=====
# DASHSCOPE_API_KEY=sk-xxxx
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_TEXT_MODEL=qwen-long

# ===== Volcengine 实时语音对话 =====
# 火山方舟/豆包实时语音 API Key，也可在系统配置页面填写。
VOLC_REALTIME_API_KEY=
VOLC_REALTIME_BASE_URL=wss://openspeech.bytedance.com/api/v3/realtime/dialogue
VOLC_REALTIME_RESOURCE_ID=volc.speech.dialog
VOLC_REALTIME_SPEAKER=zh_female_vv_jupiter_bigtts
VOLC_REALTIME_MODEL_VERSION=1.2.1.1
VOLC_REALTIME_RECV_TIMEOUT=120

# ===== ROS / 音频（可选）=====
OUTPUT_AUDIO_MODE=ros1
ROS_AUDIO_TOPIC=/audio
ROS_AUDIO_NODE_NAME=speaker_publisher
ROS_AUDIO_QUEUE_SIZE=10
ROS_AUDIO_CONTROL_TOPIC=/audio/control
ACTION_INDEX_TOPIC=/action_index
REMOTE_STATUS_TOPIC=/audio_playing_status

# 麦克风选择：留空使用系统默认设备
MIC_DEVICE_NAME=
MIC_DEVICE_INDEX=
MIC_SAMPLE_RATE=
MIC_CHANNELS=1

# ===== Frontend =====
# 前端调用后端 API 的地址
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
